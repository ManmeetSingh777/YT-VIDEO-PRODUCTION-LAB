{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "prop_support_v1.schema.json",
 "title": "PROP_SUPPORT v1.0.0 — shared support, one transform driver, explicit transfer",
 "description": "Per prop: which hands (of one or several actors) and which fixed surfaces support it, bound to REGISTERED sockets; which ONE of them is the authoritative transform driver in each half-open frame interval. Approved input alongside the PerformanceCommand packet (plan.performance.prop_support). It never contains geometry: sockets come from the measured rigs.",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema_version", "props"],
 "properties": {
  "schema_version": { "const": "1.0.0" },
  "props": {
   "type": "array", "minItems": 1,
   "items": {
    "type": "object", "additionalProperties": false,
    "required": ["id", "prop_rig_id", "test_id", "max_step_px", "surface_tolerance_px", "settle_tolerance_px", "hands", "surfaces", "authority"],
    "properties": {
     "id": { "type": "string", "minLength": 1 },
     "prop_rig_id": { "type": "string", "minLength": 1 },
     "test_id": { "type": "string", "minLength": 1 },
     "max_step_px": { "type": "number", "exclusiveMinimum": 0, "description": "largest per-frame prop root travel; more is a teleport" },
     "surface_tolerance_px": { "type": "number", "minimum": 0, "description": "prop base socket to surface target distance allowed while the surface supports it" },
     "settle_tolerance_px": { "type": "number", "minimum": 0, "description": "prop drift allowed while a surface drives it" },
     "human_quality_check": { "type": "string" },
     "hands": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["ref", "prop_socket"],
       "properties": { "ref": { "type": "string", "pattern": "^[^#]+#[^#]+$", "description": "<actor rig>#<hand name of the reviewed role map>" }, "prop_socket": { "type": "string", "minLength": 1 }, "grip_angle_deg": { "type": "number", "description": "required palm basis angle relative to the prop socket's joint (checked every locked frame)" }, "allowed_angle_deg": { "type": "number", "minimum": 0 } } }
     },
     "surfaces": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "prop_socket", "frames"],
       "properties": { "id": { "type": "string", "minLength": 1 }, "prop_socket": { "type": "string", "minLength": 1 }, "target": { "type": "object", "additionalProperties": false, "properties": { "rig_id": { "type": "string" }, "socket_id": { "type": "string" }, "world_xy": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } } }, "frames": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 } } }
     },
     "authority": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["frames", "driver", "required_supports"],
       "properties": { "frames": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 }, "driver": { "type": "string", "pattern": "^([^#]+#[^#]+|surface:.+)$" }, "required_supports": { "type": "array", "items": { "type": "string", "pattern": "^([^#]+#[^#]+|surface:.+)$" } } } }
     }
    }
   }
  }
 }
}
