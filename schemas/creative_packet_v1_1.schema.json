 "$defs": {
  "id": {
   "type": "string",
   "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
  },
  "text": {
   "type": "string",
   "minLength": 1
  },
  "sha": {
   "type": "string",
   "pattern": "^[a-f0-9]{64}$"
  },
  "frames": {
   "type": "array",
   "minItems": 2,
   "maxItems": 2,
   "items": {
    "type": "integer",
    "minimum": 0
   }
  },
  "carried": {
   "type": "object",
   "additionalProperties": false,
   "required": [
