{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://motion-native.local/schemas/creative_packet_v1_1.schema.json",
 "title": "Motion Native GPT creative packet v1.1 (executable superset of the v1.0.0 draft)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "version",
  "film_id",
  "stage",
  "source",
  "intent",
  "story",
  "identities",
  "worlds",
  "shots",
  "decisions",
  "actions",
  "transitions",
  "art_requirements",
  "audio_cues",
  "approval"
 ],
 "properties": {
  "version": {
   "const": "1.1.0"
  },
  "film_id": {
   "$ref": "#/$defs/id"
  },
  "stage": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "width",
    "height",
    "fps",
    "total_frames"
   ],
   "properties": {
    "width": {
     "const": 1920
    },
    "height": {
     "const": 1080
    },
    "fps": {
     "const": 60
    },
    "total_frames": {
     "type": "integer",
     "minimum": 1,
     "maximum": 216000
    }
   }
  },
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "script_file",
    "script_sha256",
    "direction_spec",
    "direction_spec_sha256",
    "art_skill",
    "art_skill_sha256",
    "source_witness_manifest",
    "documents"
   ],
   "properties": {
    "script_file": {
     "$ref": "#/$defs/text"
    },
    "script_sha256": {
     "$ref": "#/$defs/sha"
    },
    "direction_spec": {
     "$ref": "#/$defs/text"
    },
    "direction_spec_sha256": {
     "$ref": "#/$defs/sha"
    },
    "art_skill": {
     "const": "construct-kurzgesagt-art"
    },
    "art_skill_sha256": {
     "$ref": "#/$defs/sha"
    },
    "source_witness_manifest": {
     "type": [
      "string",
      "null"
     ]
    },
    "documents": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "role",
       "file",
       "sha256"
      ],
      "properties": {
       "role": {
        "$ref": "#/$defs/text"
       },
       "file": {
        "$ref": "#/$defs/text"
       },
       "sha256": {
        "$ref": "#/$defs/sha"
       }
      }
     }
    }
   }
  },
  "intent": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "topic",
    "audience",
    "objectives",
    "quality_bar",
    "constraints",
    "provenance",
    "decision_maker",
    "source_policy"
   ],
   "properties": {
    "topic": {
     "$ref": "#/$defs/text"
    },
    "audience": {
     "$ref": "#/$defs/text"
    },
    "objectives": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/text"
     },
     "minItems": 1
    },
    "quality_bar": {
     "$ref": "#/$defs/text"
    },
    "constraints": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/text"
     }
    },
    "provenance": {
     "$ref": "#/$defs/text"
    },
    "decision_maker": {
     "$ref": "#/$defs/text"
    },
    "source_policy": {
     "$ref": "#/$defs/text"
    }
   }
  },
  "story": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "audience_question",
    "central_insight",
    "mechanisms",
    "narration",
    "contract"
   ],
   "properties": {
    "audience_question": {
     "$ref": "#/$defs/text"
    },
    "central_insight": {
     "$ref": "#/$defs/text"
    },
    "mechanisms": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "claim",
       "epistemic_status",
       "visual_mechanism"
      ],
      "properties": {
       "id": {
        "$ref": "#/$defs/id"
       },
       "claim": {
        "$ref": "#/$defs/text"
       },
       "epistemic_status": {
        "enum": [
         "SOURCED",
         "HYPOTHESIS",
         "METAPHOR",
         "UNVERIFIED"
        ]
       },
       "visual_mechanism": {
        "$ref": "#/$defs/text"
       },
       "source_refs": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/text"
        }
       }
      }
     },
     "minItems": 1
    },
    "narration": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "text",
       "frames",
       "claim_ids"
      ],
      "properties": {
       "id": {
        "$ref": "#/$defs/id"
       },
       "text": {
        "$ref": "#/$defs/text"
       },
       "frames": {
        "$ref": "#/$defs/frames"
       },
       "claim_ids": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/id"
        }
       }
      }
     },
     "minItems": 1
    },
    "contract": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "claims",
      "mechanisms",
      "obstacles"
     ],
     "properties": {
      "claims": {
       "type": "array",
       "items": {
        "type": "object"
       }
      },
      "mechanisms": {
       "type": "array",
       "items": {
        "type": "object"
       }
      },
      "obstacles": {
       "type": "array",
       "items": {
        "type": "object"
       }
      }
     }
    }
   }
  },
  "identities": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "kind",
     "master_art",
     "views",
     "method_ids",
     "palette_roles",
     "on_stage_height_px",
     "rig",
     "acting"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/id"
     },
     "kind": {
      "enum": [
       "CHARACTER",
       "PROP",
       "MACHINE",
       "WORLD",
       "DIAGRAM",
       "EFFECT"
      ]
     },
     "master_art": {
      "$ref": "#/$defs/id"
     },
     "views": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/id"
      },
      "minItems": 1
     },
     "method_ids": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^F(0[1-9]|[1-7][0-9]|80)$"
      },
      "minItems": 1
     },
     "palette_roles": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     },
     "on_stage_height_px": {
      "anyOf": [
       {
        "type": "number",
        "exclusiveMinimum": 0
       },
       {
        "type": "null"
       }
      ]
     },
     "rig": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "$ref": "#/$defs/rig"
       }
      ]
     },
     "acting": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "$ref": "#/$defs/acting"
       }
      ]
     }
    }
   },
   "minItems": 1
  },
  "worlds": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "identity",
     "planes",
     "coverage_purpose"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/id"
     },
     "identity": {
      "$ref": "#/$defs/id"
     },
     "planes": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "art_id",
        "band"
       ],
       "properties": {
        "art_id": {
         "$ref": "#/$defs/id"
        },
        "band": {
         "enum": [
          "FAR",
          "MID",
          "FOCAL",
          "NEAR",
          "FOREGROUND"
         ]
        }
       }
      },
      "minItems": 1
     },
     "coverage_purpose": {
      "$ref": "#/$defs/text"
     }
    }
   }
  },
  "shots": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "frames",
     "world_id",
     "opening_state",
     "ending_state",
     "content_kinds",
     "attention",
     "camera",
     "entry_states",
     "exit_states",
     "hold_purpose",
     "contract"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/id"
     },
     "frames": {
      "$ref": "#/$defs/frames"
     },
     "world_id": {
      "anyOf": [
       {
        "$ref": "#/$defs/id"
       },
       {
        "type": "null"
       }
      ]
     },
     "opening_state": {
      "$ref": "#/$defs/text"
     },
     "ending_state": {
      "$ref": "#/$defs/text"
     },
     "content_kinds": {
      "type": "array",
      "items": {
       "enum": [
        "physical_action",
        "spatial_layout",
        "data_relation",
        "quantity_change",
        "inner_state",
        "scale_jump",
        "screen_content",
        "comparison",
        "world_within_world"
       ]
      },
      "minItems": 1
     },
     "attention": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "frames",
        "target"
       ],
       "properties": {
        "frames": {
         "$ref": "#/$defs/frames"
        },
        "target": {
         "$ref": "#/$defs/id"
        }
       }
      },
      "minItems": 1
     },
     "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "track_id",
       "moves"
      ],
      "properties": {
       "track_id": {
        "anyOf": [
         {
          "$ref": "#/$defs/id"
         },
         {
          "type": "null"
         }
        ]
       },
       "moves": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "frames",
          "operation",
          "purpose"
         ],
         "properties": {
          "frames": {
           "$ref": "#/$defs/frames"
          },
          "operation": {
           "enum": [
            "STATIC",
            "PAN",
            "PUSH",
            "PULL",
            "ROTATE",
            "FOLLOW",
            "ORBIT",
            "DOLLY_3D"
           ]
          },
          "purpose": {
           "$ref": "#/$defs/text"
          }
         }
        },
        "minItems": 1
       }
      }
     },
     "entry_states": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/carried"
      }
     },
     "exit_states": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/carried"
      }
     },
     "hold_purpose": {
      "type": [
       "string",
       "null"
      ]
     },
     "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "narrative_purpose",
       "viewer_experience",
       "starting_image",
       "main_action",
       "secondary_choreography",
       "character_acting",
       "camera_choreography",
       "transformation_choreography",
       "attention_path",
       "narration_and_sound",
       "exit_and_handoff",
       "failure_conditions"
      ],
      "properties": {
       "narrative_purpose": {
        "$ref": "#/$defs/text"
       },
       "viewer_experience": {
        "$ref": "#/$defs/text"
       },
       "starting_image": {
        "$ref": "#/$defs/text"
       },
       "main_action": {
        "$ref": "#/$defs/text"
       },
       "secondary_choreography": {
        "$ref": "#/$defs/text"
       },
       "character_acting": {
        "$ref": "#/$defs/text"
       },
       "camera_choreography": {
        "$ref": "#/$defs/text"
       },
       "transformation_choreography": {
        "$ref": "#/$defs/text"
       },
       "attention_path": {
        "$ref": "#/$defs/text"
       },
       "narration_and_sound": {
        "$ref": "#/$defs/text"
       },
       "exit_and_handoff": {
        "$ref": "#/$defs/text"
       },
       "failure_conditions": {
        "$ref": "#/$defs/text"
       }
      }
     }
    }
   },
   "minItems": 1
  },
  "decisions": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "shot_id",
     "frames",
     "script_span",
     "viewer_effect",
     "intent",
     "intended_experience",
     "consumer_ids",
     "operation",
     "art_capabilities",
     "audio_consequence"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/id"
     },
     "shot_id": {
      "$ref": "#/$defs/id"
     },
     "frames": {
      "$ref": "#/$defs/frames"
     },
     "script_span": {
      "$ref": "#/$defs/text"
     },
     "viewer_effect": {
      "$ref": "#/$defs/text"
     },
     "intent": {
      "$ref": "#/$defs/text"
     },
     "intended_experience": {
      "$ref": "#/$defs/text"
     },
     "consumer_ids": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/id"
      },
      "minItems": 1
     },
     "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "owner",
       "operation"
      ],
      "properties": {
       "owner": {
        "$ref": "#/$defs/id"
       },
       "operation": {
        "$ref": "#/$defs/text"
       },
       "joint": {
        "$ref": "#/$defs/id"
       },
       "channel": {
        "$ref": "#/$defs/id"
       },
       "state": {
        "$ref": "#/$defs/id"
       },
       "target": {
        "$ref": "#/$defs/id"
       },
       "min_px": {
        "type": "number"
       },
       "min_deg": {
        "type": "number"
       },
       "reason": {
        "$ref": "#/$defs/text"
       }
      }
     },
     "art_capabilities": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/id"
      }
     },
     "audio_consequence": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "minItems": 1
  },
  "actions": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "shot_id",
     "owner",
     "target",
     "frames",
     "mode",
     "verb_class",
     "no_verb_reason",
     "intent",
     "phases",
     "precondition",
     "postcondition",
     "visible_result",
     "target_state",
     "min_angle_deg",
     "art_ids",
     "direction_ids",
     "staging",
     "contact_events",
     "pose_events",
     "view_events",
     "state_events",
     "secondary_purpose"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/id"
     },
     "shot_id": {
      "$ref": "#/$defs/id"
     },
     "owner": {
      "$ref": "#/$defs/id"
     },
     "target": {
      "anyOf": [
       {
        "$ref": "#/$defs/id"
       },
       {
        "type": "null"
       }
      ]
     },
     "frames": {
      "$ref": "#/$defs/frames"
     },
     "mode": {
      "enum": [
       "RIGID",
       "ARTICULATED",
       "REGISTERED_CELS",
       "REGISTERED_MORPH",
       "EXPLICIT_DEFORM",
       "PROCEDURAL",
       "CAMERA_WORLD",
       "TRANSITION"
      ]
     },
     "verb_class": {
      "type": [
       "string",
       "null"
      ]
     },
     "no_verb_reason": {
      "type": [
       "string",
       "null"
      ]
     },
     "intent": {
      "$ref": "#/$defs/text"
     },
     "phases": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "name",
        "frames",
        "state"
       ],
       "properties": {
        "name": {
         "$ref": "#/$defs/text"
        },
        "frames": {
         "$ref": "#/$defs/frames"
        },
        "state": {
         "$ref": "#/$defs/text"
        }
       }
      },
      "minItems": 1
     },
     "precondition": {
      "$ref": "#/$defs/text"
     },
     "postcondition": {
      "$ref": "#/$defs/text"
     },
     "visible_result": {
      "$ref": "#/$defs/text"
     },
     "target_state": {
      "type": [
       "string",
       "null"
      ]
     },
     "min_angle_deg": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "art_ids": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/id"
      },
      "minItems": 1
     },
     "direction_ids": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/id"
      },
      "minItems": 1
     },
     "staging": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "rig",
        "root_xy",
        "scale"
       ],
       "properties": {
        "rig": {
         "$ref": "#/$defs/id"
        },
        "root_xy": {
         "type": "array",
         "minItems": 2,
         "maxItems": 2,
         "items": {
          "type": "number"
         }
        },
        "scale": {
         "type": "number",
         "exclusiveMinimum": 0
        }
       }
      }
     },
     "contact_events": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/contact"
      }
     },
     "pose_events": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "frame",
        "state",
        "rig",
        "transition"
       ],
       "properties": {
        "frame": {
         "type": "integer",
         "minimum": 0
        },
        "state": {
         "$ref": "#/$defs/id"
        },
        "rig": {
         "$ref": "#/$defs/id"
        },
        "transition": {
         "$ref": "#/$defs/policy"
        }
       }
      }
     },
     "view_events": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "frame",
        "from",
        "to",
        "rig",
        "transition"
       ],
       "properties": {
        "frame": {
         "type": "integer",
         "minimum": 0
        },
        "from": {
         "$ref": "#/$defs/id"
        },
        "to": {
         "$ref": "#/$defs/id"
        },
        "rig": {
         "$ref": "#/$defs/id"
        },
        "transition": {
         "$ref": "#/$defs/policy"
        }
       }
      }
     },
     "state_events": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "frame",
        "channel",
        "state",
        "rig",
        "transition"
       ],
       "properties": {
        "frame": {
         "type": "integer",
         "minimum": 0
        },
        "channel": {
         "$ref": "#/$defs/id"
        },
        "state": {
         "$ref": "#/$defs/id"
        },
        "rig": {
         "$ref": "#/$defs/id"
        },
        "transition": {
         "$ref": "#/$defs/policy"
        }
       }
      }
     },
     "secondary_purpose": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "minItems": 1
  },
  "transitions": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "from_shot",
     "to_shot",
     "mode",
     "frames",
     "reason",
     "continuity_invariant",
     "out",
     "middle",
     "in",
     "masks",
     "shared_landmarks"
    ],
    "properties": {
     "from_shot": {
      "$ref": "#/$defs/id"
     },
     "to_shot": {
      "$ref": "#/$defs/id"
     },
     "mode": {
      "enum": [
       "CUT",
       "CONTINUOUS"
      ]
     },
     "frames": {
      "$ref": "#/$defs/frames"
     },
     "reason": {
      "$ref": "#/$defs/text"
     },
     "continuity_invariant": {
      "$ref": "#/$defs/text"
     },
     "out": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/id"
      }
     },
     "middle": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/id"
      }
     },
     "in": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/id"
      }
     },
     "masks": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/id"
      }
     },
     "shared_landmarks": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/id"
      }
     }
    }
   }
  },
  "phrases": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "art_requirements": {
   "type": "array",
   "items": {
