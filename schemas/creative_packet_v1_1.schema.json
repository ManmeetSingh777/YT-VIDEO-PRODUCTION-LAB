      "properties": {
       "from": {
        "$ref": "#/$defs/id"
       },
       "to": {
        "$ref": "#/$defs/id"
       },
       "mode": {
        "enum": [
         "RIGID_CONTINUOUS",
         "CEL_SEQUENCE",
         "MATCHED_VECTOR_MORPH",
         "REGISTERED_SWAP",
         "EXPLICIT_DEFORM"
        ]
       },
       "landmarks": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/id"
        },
        "minItems": 1
       },
       "max_transition_frames": {
        "type": "integer",
        "minimum": 0
       },
       "occluder": {
        "anyOf": [
         {
          "$ref": "#/$defs/id"
         },
         {
          "type": "null"
         }
        ]
       }
      }
     }
    }
   }
  },
  "acting": {
   "type": "object",
