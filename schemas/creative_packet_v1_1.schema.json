        }
       },
       "landmarks": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/id"
        }
       }
      }
     }
    },
    "edges": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "from",
       "to",
       "mode",
       "landmarks",
       "max_transition_frames",
       "occluder"
