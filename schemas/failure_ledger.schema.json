{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HYBRID_V2_FAILURE_LEDGER",
  "description": "Directive D.3: generated by engine/tools/build_failure_ledger.mjs from executed test results; a row can never be QUALIFIED without linked, hashed, passing proofs. QUALIFIED_ON_REAL_ART requires provider pixels + human review evidence.",
  "type": "object",
  "required": ["generated_by", "revision", "tap_log_sha256", "rows"],
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "failed_invariant", "root_producers", "applicability", "repair", "proof_tests", "transfer_tests", "external_dependencies", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^F\\d{3}$" },
          "status": { "enum": ["FAIL", "NOT_IMPLEMENTED", "IMPLEMENTED_UNQUALIFIED", "QUALIFIED_ON_DIAGNOSTICS", "QUALIFIED_ON_REAL_ART", "QUALIFIED_FULL_FILM", "EXTERNAL_APPROVAL_REQUIRED"] },
          "proof_tests": { "type": "array", "minItems": 1 },
          "external_dependencies": { "type": "array" }
        }
      }
    }
  }
}
