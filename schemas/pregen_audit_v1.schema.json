{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pregen_audit_v1.schema.json",
 "title": "PREGEN_AUDIT v1.0.0 — ten subject-specific pre-generation gap-finding passes for a new canonical master",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema_version", "job_id", "design_sha256", "witness_manifest_sha256", "operator", "skill_version_verified", "passes"],
 "properties": {
  "schema_version": { "const": "1.0.0" },
  "job_id": { "type": "string", "minLength": 1 },
  "design_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
  "witness_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
  "operator": { "type": "string", "minLength": 2, "description": "who ran the passes (operator-attested; not a human approval)" },
  "skill_version_verified": { "type": "string", "minLength": 8, "description": "the installed F01-F80 skill the art chat actually read (e.g. SKILL.md sha256)" },
  "passes": {
   "type": "array", "minItems": 10, "maxItems": 10,
   "items": {
    "type": "object", "additionalProperties": false,
    "required": ["domain", "question", "findings", "decisions"],
    "properties": {
     "domain": { "type": "string" },
     "question": { "type": "string", "description": "the most important unresolved question of THIS domain for THIS subject" },
     "findings": { "type": "string" },
     "decisions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["decision"], "properties": { "decision": { "type": "string" }, "method_ids": { "type": "array", "items": { "type": "string" } }, "witness": { "type": "object", "additionalProperties": false, "required": ["file", "observation"], "properties": { "file": { "type": "string" }, "region_px": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }, "observation": { "type": "string" } } } } } },
     "open_risks": { "type": "array", "items": { "type": "string" } },
     "reopens": { "type": "array", "items": { "type": "string" } },
     "no_reopen_reason": { "type": "string" }
    }
   }
  }
 }
}
